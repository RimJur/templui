package timepicker

import (
	"fmt"
	"github.com/RimJur/templui/components/button"
	"github.com/RimJur/templui/components/card"
	"github.com/RimJur/templui/components/icon"
	"github.com/RimJur/templui/components/popover"
	"github.com/RimJur/templui/utils"
	"strconv"
	"time"
)

// emptySegment is what a segment shows before it holds a value, mirroring the
// native <input type="time"> placeholder.
const emptySegment = "--"

type Props struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Name        string
	Form        string
	Value       time.Time
	MinTime     time.Time
	MaxTime     time.Time
	Step        int
	Use12Hours  bool
	AMLabel     string
	PMLabel     string
	Placeholder string
	Disabled    bool
	HasError    bool
	// HourLabel, MinuteLabel and PeriodLabel name the segments for assistive
	// technology and title the columns in the dropdown.
	HourLabel   string
	MinuteLabel string
	PeriodLabel string
	// OpenLabel names the button that opens the dropdown.
	OpenLabel string
	// DoneLabel is the dropdown's dismiss button.
	DoneLabel string
	// EmptyLabel is how a segment holding no value yet is announced, as
	// "{EmptyLabel} {HourLabel}". Without it the announcement stays English
	// while the labels around it are translated.
	EmptyLabel string
}

templ TimePicker(props ...Props) {
	{{
		var p Props
		if len(props) > 0 {
			p = props[0]
		}
		if p.ID == "" {
			p.ID = utils.RandomID()
		}
		if p.Name == "" {
			p.Name = p.ID
		}
		if p.Placeholder == "" {
			p.Placeholder = "Select time"
		}
		if p.AMLabel == "" {
			p.AMLabel = "AM"
		}
		if p.PMLabel == "" {
			p.PMLabel = "PM"
		}
		if p.HourLabel == "" {
			p.HourLabel = "Hour"
		}
		if p.MinuteLabel == "" {
			p.MinuteLabel = "Minute"
		}
		if p.PeriodLabel == "" {
			p.PeriodLabel = "AM/PM"
		}
		if p.OpenLabel == "" {
			p.OpenLabel = "Open time picker"
		}
		if p.DoneLabel == "" {
			p.DoneLabel = "Done"
		}
		if p.EmptyLabel == "" {
			p.EmptyLabel = "Empty"
		}
		if p.Step <= 0 {
			p.Step = 1
		}

		hasValue := p.Value != (time.Time{})

		var valueString string
		if hasValue {
			valueString = p.Value.Format("15:04")
		}
		var minTimeString string
		if p.MinTime != (time.Time{}) {
			minTimeString = p.MinTime.Format("15:04")
		}
		var maxTimeString string
		if p.MaxTime != (time.Time{}) {
			maxTimeString = p.MaxTime.Format("15:04")
		}

		// Render the segments server-side so a preset value is visible before
		// the script runs.
		hourSegment, minuteSegment, periodSegment := emptySegment, emptySegment, emptySegment
		if hasValue {
			h := p.Value.Hour()
			if p.Use12Hours {
				periodSegment = p.AMLabel
				if h >= 12 {
					periodSegment = p.PMLabel
				}
				if h%12 == 0 {
					h = 12
				} else {
					h = h % 12
				}
			}
			hourSegment = fmt.Sprintf("%02d", h)
			minuteSegment = fmt.Sprintf("%02d", p.Value.Minute())
		}

		hourMax := 23
		hourMin := 0
		if p.Use12Hours {
			hourMax = 12
			hourMin = 1
		}
	}}
	<div class="relative inline-block w-full" data-tui-timepicker-root>
		@popover.Root(popover.RootProps{ID: p.ID + "-popover"}) {
			<input
				type="hidden"
				name={ p.Name }
				value={ valueString }
				if p.Form != "" {
					form={ p.Form }
				}
				data-tui-timepicker-hidden-input="true"
			/>
			// The trigger is manual: a click has to distinguish focusing a
			// segment from opening the dropdown, which popover's own click
			// handler cannot do (it preventDefaults every click inside).
			@popover.Trigger(popover.TriggerProps{TriggerType: popover.TriggerTypeManual}) {
				<div
					data-tui-timepicker="true"
					data-tui-timepicker-use12hours={ fmt.Sprintf("%t", p.Use12Hours) }
					data-tui-timepicker-am-label={ p.AMLabel }
					data-tui-timepicker-pm-label={ p.PMLabel }
					data-tui-timepicker-placeholder={ p.Placeholder }
					data-tui-timepicker-step={ fmt.Sprintf("%d", p.Step) }
					data-tui-timepicker-min-time={ minTimeString }
					data-tui-timepicker-max-time={ maxTimeString }
					role="group"
					aria-label={ p.Placeholder }
					if p.Disabled {
						aria-disabled="true"
					}
					class={ utils.TwMerge(
						// Base styles matching input
						"w-full h-9 px-3 py-1 text-base md:text-sm",
						"flex items-center justify-between gap-2",
						"rounded-md border border-input bg-transparent shadow-xs transition-[color,box-shadow] outline-none",
						// Dark mode background
						"dark:bg-input/30",
						// Focus styles follow whichever segment holds focus
						"focus-within:border-ring focus-within:ring-ring/50 focus-within:ring-[3px]",
						// Error/Invalid styles. aria-invalid now sits on the
						// segments, so the box follows whichever one carries it
						// -- including when a validation library sets it later.
						"has-[[aria-invalid]]:ring-destructive/20 has-[[aria-invalid]]:border-destructive dark:has-[[aria-invalid]]:ring-destructive/40",
						utils.If(p.HasError, "border-destructive ring-destructive/20 dark:ring-destructive/40"),
						utils.If(p.Disabled, "opacity-50 cursor-not-allowed"),
						p.Class,
					) }
					{ p.Attributes... }
				>
					<div class="flex items-center grow" data-tui-timepicker-segments>
						@segment(p.ID, "hour", p.HourLabel, p.EmptyLabel, hourSegment, hourMin, hourMax, p.Disabled, p.HasError)
						<span aria-hidden="true" class="text-muted-foreground select-none">:</span>
						@segment("", "minute", p.MinuteLabel, p.EmptyLabel, minuteSegment, 0, 59, p.Disabled, p.HasError)
						if p.Use12Hours {
							@segment("", "period", p.PeriodLabel, p.EmptyLabel, periodSegment, 0, 1, p.Disabled, p.HasError, p.AMLabel, p.PMLabel, emptySegment)
						}
					</div>
					// -m-1 keeps the icon where it was while the hit area grows
					// to the 24x24 WCAG 2.5.8 minimum; a bare 16px icon was the
					// only pointer route to the dropdown.
					<button
						type="button"
						data-tui-timepicker-toggle="true"
						aria-label={ p.OpenLabel }
						tabindex="-1"
						disabled?={ p.Disabled }
						class="text-muted-foreground flex items-center justify-center shrink-0 p-1 -m-1 rounded-sm outline-none hover:text-foreground disabled:cursor-not-allowed"
					>
						@icon.Clock(icon.Props{Class: "size-4"})
					</button>
				</div>
			}
			@popover.Content(popover.ContentProps{
				Placement: popover.PlacementBottomStart,
				Class:     "p-0 w-80",
			}) {
				@card.Card(card.Props{
					Class: "border-0 shadow-none",
				}) {
					@card.Content(card.ContentProps{
						Class: "p-4",
					}) {
						<div
							data-tui-timepicker-popup="true"
							data-tui-timepicker-input-name={ p.Name }
							if valueString != "" {
								data-tui-timepicker-value={ valueString }
							}
						>
							// Time selection grid
							<div class="grid grid-cols-2 gap-3 mb-4">
								// Hour selection
								<div class="space-y-2">
									<label class="text-sm font-medium">{ p.HourLabel }</label>
									<div class="max-h-32 overflow-y-auto border rounded-md bg-background">
										<div data-tui-timepicker-hour-list="true" class="p-1 space-y-0.5">
											if p.Use12Hours {
												// 12-hour format: 12, 01-11
												<button
													type="button"
													data-tui-timepicker-hour="0"
													data-tui-timepicker-selected="false"
													class="w-full px-2 py-1 text-sm rounded transition-colors text-left hover:bg-accent hover:text-accent-foreground data-[tui-timepicker-selected=true]:bg-primary data-[tui-timepicker-selected=true]:text-primary-foreground data-[tui-timepicker-selected=true]:hover:bg-primary/90"
												>
													12
												</button>
												for hour := 1; hour <= 11; hour++ {
													<button
														type="button"
														data-tui-timepicker-hour={ strconv.Itoa(hour) }
														data-tui-timepicker-selected="false"
														class="w-full px-2 py-1 text-sm rounded transition-colors text-left hover:bg-accent hover:text-accent-foreground data-[tui-timepicker-selected=true]:bg-primary data-[tui-timepicker-selected=true]:text-primary-foreground data-[tui-timepicker-selected=true]:hover:bg-primary/90"
													>
														{ fmt.Sprintf("%02d", hour) }
													</button>
												}
											} else {
												// 24-hour format: 00-23
												for hour := 0; hour < 24; hour++ {
													<button
														type="button"
														data-tui-timepicker-hour={ strconv.Itoa(hour) }
														data-tui-timepicker-selected="false"
														class="w-full px-2 py-1 text-sm rounded transition-colors text-left hover:bg-accent hover:text-accent-foreground data-[tui-timepicker-selected=true]:bg-primary data-[tui-timepicker-selected=true]:text-primary-foreground data-[tui-timepicker-selected=true]:hover:bg-primary/90"
													>
														{ fmt.Sprintf("%02d", hour) }
													</button>
												}
											}
										</div>
									</div>
								</div>
								// Minute selection
								<div class="space-y-2">
									<label class="text-sm font-medium">{ p.MinuteLabel }</label>
									<div class="max-h-32 overflow-y-auto border rounded-md bg-background">
										<div data-tui-timepicker-minute-list="true" class="p-1 space-y-0.5">
											for minute := 0; minute < 60; minute += p.Step {
												<button
													type="button"
													data-tui-timepicker-minute={ strconv.Itoa(minute) }
													data-tui-timepicker-selected="false"
													class="w-full px-2 py-1 text-sm rounded transition-colors text-left hover:bg-accent hover:text-accent-foreground data-[tui-timepicker-selected=true]:bg-primary data-[tui-timepicker-selected=true]:text-primary-foreground data-[tui-timepicker-selected=true]:hover:bg-primary/90"
												>
													{ fmt.Sprintf("%02d", minute) }
												</button>
											}
										</div>
									</div>
								</div>
							</div>
							// AM/PM selector and action buttons
							<div class="flex justify-between items-center">
								if p.Use12Hours {
									<div class="flex gap-1">
										<button
											type="button"
											data-tui-timepicker-period="AM"
											data-tui-timepicker-active="false"
											class="px-3 py-1 text-sm rounded-md border transition-colors hover:bg-accent hover:text-accent-foreground data-[tui-timepicker-active=true]:bg-primary data-[tui-timepicker-active=true]:text-primary-foreground data-[tui-timepicker-active=true]:hover:bg-primary/90"
										>
											{ p.AMLabel }
										</button>
										<button
											type="button"
											data-tui-timepicker-period="PM"
											data-tui-timepicker-active="false"
											class="px-3 py-1 text-sm rounded-md border transition-colors hover:bg-accent hover:text-accent-foreground data-[tui-timepicker-active=true]:bg-primary data-[tui-timepicker-active=true]:text-primary-foreground data-[tui-timepicker-active=true]:hover:bg-primary/90"
										>
											{ p.PMLabel }
										</button>
									</div>
								} else {
									<div></div>
								}
								@button.Button(button.Props{
									Type:    "button",
									Variant: button.VariantSecondary,
									Size:    button.SizeSm,
									Attributes: templ.Attributes{
										"data-tui-timepicker-done": "true",
									},
								}) {
									{ p.DoneLabel }
								}
							</div>
						</div>
					}
				}
			}
		}
	</div>
}

// segment renders one typeable field of the time. It is a spinbutton rather
// than a plain text box: the value is always driven from component state, so
// the element only ever reports what the state holds.
//
// hasError puts aria-invalid on the segments rather than on the wrapper around
// them, because a screen reader reports that state from the control that takes
// focus.
// Passing sizers switches the segment from a ch-based width to one measured
// from those strings. Hours and minutes are digits, so 2ch under tabular-nums
// is exact; the period reads AM/PM, whose letters are wider than a zero and
// whose text is caller-supplied, so no ch count can be right for it.
templ segment(id, kind, label, emptyLabel, value string, min, max int, disabled, hasError bool, sizers ...string) {
	if len(sizers) > 0 {
		// Every candidate label rides along invisibly in the same grid cell, so
		// the column takes the widest of them and the box keeps its size when
		// the value flips between them.
		// The input is taken out of flow: a text input carries an intrinsic
		// width of its own that would otherwise win the column and leave the
		// box wider than the labels it is meant to fit.
		<span class="relative grid items-center shrink-0">
			// px-2 against the input's px-1 leaves 4px of slack in the column.
			// Matching them exactly sizes the column to the text and sub-pixel
			// rounding then clips it -- and an input clips to nothing rather
			// than truncating, so the label vanishes outright.
			for _, sizer := range sizers {
				<span aria-hidden="true" class="col-start-1 row-start-1 invisible px-2 py-0.5 text-center whitespace-pre">{ sizer }</span>
			}
			@segmentInput(id, kind, label, emptyLabel, value, min, max, disabled, hasError, "absolute inset-0 py-0")
		</span>
	} else {
		@segmentInput(id, kind, label, emptyLabel, value, min, max, disabled, hasError, "box-content w-[2ch] shrink-0 tabular-nums")
	}
}

templ segmentInput(id, kind, label, emptyLabel, value string, min, max int, disabled, hasError bool, sizing string) {
	<input
		if id != "" {
			id={ id }
		}
		type="text"
		data-tui-timepicker-segment={ kind }
		if kind == "period" {
			inputmode="text"
		} else {
			inputmode="numeric"
			maxlength="2"
		}
		role="spinbutton"
		aria-label={ label }
		data-tui-timepicker-empty-label={ emptyLabel }
		if hasError {
			aria-invalid="true"
		}
		aria-valuemin={ strconv.Itoa(min) }
		aria-valuemax={ strconv.Itoa(max) }
		if value != emptySegment {
			aria-valuenow={ value }
			aria-valuetext={ value }
		} else {
			aria-valuetext={ emptyLabel + " " + label }
		}
		value={ value }
		size="1"
		autocomplete="off"
		autocorrect="off"
		autocapitalize="off"
		spellcheck="false"
		disabled?={ disabled }
		class={ utils.TwMerge(
			"rounded-sm px-1 py-0.5 text-center bg-transparent border-0 outline-none caret-transparent selection:bg-transparent focus:bg-primary focus:text-primary-foreground disabled:cursor-not-allowed",
			sizing,
		) }
	/>
}

var scriptOnce = templ.NewOnceHandle()

templ Script() {
	@scriptOnce.Once() {
		@popover.Script()
		@utils.ComponentScript("timepicker")
	}
}
